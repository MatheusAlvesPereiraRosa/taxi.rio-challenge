generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "mysql"
    url      = env("DATABASE_URL")
}

enum UserRole {
    PASSENGER
    DRIVER
}

enum RideStatus {
    REQUESTED
    ACCEPTED
    IN_PROGRESS
    COMPLETED
    CANCELLED
}

model User {
    id           String   @id @default(uuid()) @db.Char(36)
    name         String   @db.VarChar(100)
    email        String   @unique @db.VarChar(255)
    passwordHash String   @db.VarChar(255)
    role         UserRole
    createdAt    DateTime @default(now())

    passengerRides Ride[] @relation("PassengerRides")
    driverRides    Ride[] @relation("DriverRides")
}

model Ride {
    id String @id @default(uuid()) @db.Char(36)

    passengerId String  @db.Char(36)
    driverId    String? @db.Char(36)

    originAddress   String @db.VarChar(255)
    originLatitude  Float
    originLongitude Float

    destinationAddress   String @db.VarChar(255)
    destinationLatitude  Float
    destinationLongitude Float

    status  RideStatus @default(REQUESTED)
    version Int        @default(1)

    idempotencyKey String? @db.VarChar(255)
    requestHash    String? @db.VarChar(255)

    createdAt  DateTime  @default(now())
    updatedAt  DateTime  @updatedAt
    canceledAt DateTime?

    passenger User  @relation("PassengerRides", fields: [passengerId], references: [id])
    driver    User? @relation("DriverRides", fields: [driverId], references: [id])

    @@unique([passengerId, idempotencyKey])
    @@index([driverId])
    @@index([status])
}

model RideOutboxEvent {
    id          String    @id @default(uuid()) @db.Char(36)
    rideId      String    @db.Char(36)
    type        String    @db.VarChar(64)
    payload     Json
    createdAt   DateTime  @default(now())
    publishedAt DateTime?

    @@index([publishedAt, createdAt])
}