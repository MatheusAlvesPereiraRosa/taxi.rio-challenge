
# ==========================================
# Dependencies
# ==========================================

node_modules/
.pnp/
.pnp.js

# ==========================================
# Environment variables and secrets
# ==========================================

.env
.env.*
!.env.example
!.env.template

*.key
*.p12
*.pfx
*.crt
*.cer

# JWT private keys
**/private.pem
**/private.key

# ==========================================
# Node.js / NestJS / React / Vite
# ==========================================

npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

lerna-debug.log*

dist/
build/
.next/
.nuxt/
.output/
.vite/
coverage/

*.tsbuildinfo

# ==========================================
# Prisma
# ==========================================

# Keep Prisma schema and migrations tracked.
# Ignore generated Prisma client if generated locally.
# (Usually generated inside node_modules)

# ==========================================
# Logs
# ==========================================

logs/
*.log
log/
npm-debug.log*

# ==========================================
# Docker
# ==========================================

# Local Docker overrides
docker-compose.override.yml

# Local volumes / persisted data
docker-data/
data/
volumes/

# ==========================================
# Databases
# ==========================================

*.sqlite
*.sqlite3
*.db

# MongoDB local data
mongodb-data/

# MySQL local data
mysql-data/

# Redis local data
redis-data/

# ==========================================
# Python (load testing / utility scripts)
# ==========================================

__pycache__/
*.py[cod]
*$py.class

.venv/
venv/
ENV/

.pytest_cache/
.mypy_cache/
.ruff_cache/

# ==========================================
# Kubernetes
# ==========================================

# Local cluster configuration
.kube/
kind-config.yaml

# Never commit local secret manifests
**/secret.local.yaml
**/secrets.local.yaml

# ==========================================
# Load testing
# ==========================================

# Generated k6 results
loadtest/results/*
!loadtest/results/.gitkeep

# ==========================================
# Observability
# ==========================================

# Local Grafana data
observability/grafana/data/

# Generated profiling / temporary files
*.prof
*.pprof

# ==========================================
# IDEs and editors
# ==========================================

.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ==========================================
# Operating system
# ==========================================

.DS_Store
Thumbs.db
desktop.ini

# ==========================================
# Temporary files
# ==========================================

tmp/
temp/
.cache/
*.tmp
*.bak
*.swp
*.swo
